.zcode

# Speaker Identification project
logs/*
checkpoints/*
!logs/.gitkeep
!checkpoints/.gitkeep
# Runtime logs (pipeline / analysis run output) — never committed.
*.log
*.pt
*.pth
# Model weights — downloaded via scripts/download_all_weights.py,
# never committed (they are bundled into the submission zip instead).
weights/
# Submission package build outputs (rebuilt via scripts/build_submission.py).
submission/src/
submission/configs/
submission/vendor/
submission/centroids/
submission/decision_config.json
data/processed/*
!data/processed/.gitkeep
# Large external augmentation datasets (downloaded on demand, never committed).
data/augmentation/
Competition-Guide
__pycache__

# Environment
.env
.venv/

# MLOps / ZenML
zenml_config/
zenml_metadata.sqlite3
*.db
*.sqlite3

# MLflow
mlruns/
mlartifacts/

# DagsHub
.dagshub/

# Streamlit
.streamlit/

# Named experiment profiles (source of truth is committed; resolved snapshots
# are derived and written under _resolved/).
configs/experiments/_resolved/
# Transient Optuna trial profiles (the durable output is the '<study>-best' profile).
configs/experiments/hpo-trial-*.yaml
# Runtime experiment queue state + matrix manifest + per-job logs.
data/experiments/

# OS
Thumbs.db
.DS_Store

# Local backups of old model artifacts / submission zips (restore points, not source)
backup_20260816/


eda
# Leaderboard submission zip (built artifact — never commit)
submission_leaderboard.zip
*.zip

# Temporary inspection/rendering artifacts (for example rendered PDF pages).
tmp/
