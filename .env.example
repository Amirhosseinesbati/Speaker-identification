# ─────────────────────────────────────────────────────────
# Speaker-Identification — MLOps Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Vast.ai (GPU Cloud) ──
VAST_API_KEY="your_vast_api_key_here"

# ── DagsHub (Experiment Tracking & Data Versioning) ──
DAGSHUB_USER_TOKEN="your_dagshub_token_here"
DAGSHUB_REPO_OWNER="amiresbati52"
DAGSHUB_REPO_NAME="Speaker-identification"
DAGSHUB_TRACKING_URI="https://dagshub.com/amiresbati52/Speaker-identification.mlflow"

# ── Git Repository (for Vast.ai setup) ──
GIT_REPO_URL="https://github.com/amiresbati52/Speaker-identification"
# NOTE: Set this to the branch that has your latest MLOps code.
# The current working branch with all the new changes is "feature/advanced-speaker-id".
GIT_BRANCH="feature/advanced-speaker-id"

# ── Kaggle (optional, for dataset downloads) ──
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# ── Overrides (set by deploy_app.py when using Streamlit UI) ──
# GPU_TARGET="RTX_3090"   # or RTX_3060 (batch 16) / RTX_A4000 (16GB, batch 24)
# TARGET_PIPELINE="all"
