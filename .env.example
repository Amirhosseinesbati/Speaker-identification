# ─────────────────────────────────────────────────────────
# Speaker-Identification — MLOps Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Vast.ai (GPU Cloud) ──
VAST_API_KEY="your_vast_api_key_here"

# ── DagsHub (Experiment Tracking & Data Versioning) ──
DAGSHUB_USER_TOKEN="your_dagshub_token_here"
DAGSHUB_REPO_OWNER="amiresbati52"
DAGSHUB_REPO_NAME="Speaker-identification"
DAGSHUB_TRACKING_URI="https://dagshub.com/amiresbati52/Speaker-identification.mlflow"

# ── Git Repository (for Vast.ai setup) ──
GIT_REPO_URL="https://github.com/amiresbati52/Speaker-identification"
# NOTE: Set this to the branch that has your latest MLOps code.
# The current working branch with all the new changes is "feature/advanced-speaker-id".
GIT_BRANCH="feature/advanced-speaker-id"

# ── Kaggle (optional, for dataset downloads) ──
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# ── Overrides (set by deploy_app.py when using Streamlit UI) ──
# GPU_TARGET="RTX_3090"   # or RTX_3060 (batch 16) / RTX_A4000 (16GB, batch 24)
# TARGET_PIPELINE="all"

# ── Server-selection filters (optional; all default to 0 = no filter, so the
#    search takes whatever the market has and ranks by reliability → internet →
#    CPU. Every numeric gate has a min and a max twin (0 = open). Defaults also
#    live in configs/default_config.yaml → mlops.vast.selector) ──
# VAST_POOL_SIZE="50"             # top-N cheapest candidates to fetch
# VAST_RETRY_COUNT="3"            # how many of the ranked pool to try renting
# VAST_MIN_RELIABILITY="0"        # host uptime health (0..1); min only
# VAST_MIN_INET_DOWN_MBS="0"      # download MB/s
# VAST_MAX_INET_DOWN_MBS="0"
# VAST_MIN_INET_UP_MBS="0"        # upload MB/s
# VAST_MAX_INET_UP_MBS="0"
# VAST_MIN_CPU_CORES="0"
# VAST_MAX_CPU_CORES="0"
# VAST_MIN_CPU_RAM_GB="0"
# VAST_MAX_CPU_RAM_GB="0"
# VAST_MIN_DISK_GB="0"
# VAST_MAX_DISK_GB="0"
# VAST_MIN_DURATION_DAYS="0"
# VAST_MAX_DURATION_DAYS="0"
# VAST_MIN_PRICE="0"              # $/h band
# VAST_MAX_PRICE="0"
# VAST_MIN_PCIE_BW="0"            # CPU↔GPU PCIe bandwidth (GB/s)
# VAST_MAX_PCIE_BW="0"
# VAST_MIN_GPU_FRAC="0"           # min GPU fraction; 1.0 = full GPU only
# VAST_BLOCKED_COUNTRIES=""       # comma-separated ISO codes, e.g. US,HK
# VAST_PICK_BEST="true"           # true = best by quality score; false = cheapest
